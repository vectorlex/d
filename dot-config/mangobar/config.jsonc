// mangobar config (JSONC).
{
    "layer": "top",
    "height": 28,
    "buffer-scale": 1,
    // "scroll-interval": 100,
    // "smooth-scrolling-threshold": 5.0,

    "modules-left": [
        "workspaces",
        "window"
    ],
    "modules-center": [
      "clock#time",
    ],
    "modules-right": [
        "hideclients",
        "tray",
        "cpu",
        "memory",
        "pulseaudio",
    ],
    "workspaces": {
        "hide-empty": true,
        "overview-label": "O",
        "on-click": "activate",
        "on-click-right": "toggle"
    },
    "window": {
        "format": "{}",
    },
    "hideclients": {
        "format": " {}"
    },
    "cpu": {
        "format": " {load}%"
    },
    "memory": {
        "format": " {}%"
    },
    "pulseaudio": {
        "format": "{icon} {volume}% {bt}",
        "format-muted": "󰝟 {volume}% {bt}",
        "icons": ["󰝟", "󰕿", "󰕾"],
        // "icon-bluetooth": "󰂯",
        "on-click": "pamixer -t",
        "on-scroll-up": "pamixer -i 2",
        "on-scroll-down": "pamixer -d 2"
    },
    "clock#time": {
        "interval": 100,
        "format": "{:L%H:%M}"
    },
    "tray": {
        "icon-size": 25,
        "spacing": 8
    }
}
