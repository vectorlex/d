// -*- mode: jsonc -*-
{
    "layer": "top", // Waybar at top layer
    "height": 28, // Waybar height (to be removed for auto height)
    "spacing": 14, // Gaps between modules (4px)
    "modules-left": [
        "mango/workspaces",
        "mango/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "power-profiles-daemon",
        "cpu",
        "memory",
        "wireplumber#sink",
        "custom/power"
    ],
    "mango/workspaces": {
	      "format": "{value}",
        "hide-empty": true,
	      "on-click": "activate",
	      "on-click-right": "toggle",
	      "overview-label": " "
    },
    "mango/window": {
	      "format": "{title}",
	      "icon": true,
	      "icon-size": 16
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "clock": {
      "interval": 1,
      "format": "{:%H:%M:%S}",
      "format-alt": "{:%Y/%m/%d}",
      "locale": "zh_CN.UTF-8",
    	"tooltip-format": "{:%Y年%m月%d日，周%u}",
    	"actions": {
    		"on-click-right": "mode",
    		"on-click-forward": "tz_up",
    		"on-click-backward": "tz_down",
		    "on-scroll-up": "shift_up",
    		"on-scroll-down": "shift_down"
    	}
    },
    "cpu": {
        "interval": 1,
        "format": " {usage}%"
    },
    "memory": {
        "interval": 1,
        "format": " {used:0.2f}G"
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nCPU driver: {cpu_driver}\nPlatform driver: {platform_driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },
    "wireplumber#sink": {
        "format": "{icon}  {volume}%",
        "format-muted": "  muted",
        "format-icons": ["", "", ""],
        "on-click": "pwvucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },
    "custom/power": {
        "format" : "⏻  ",
		    "tooltip": false,
		    "menu": "on-click",
		    "menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
		    "menu-actions": {
            "logout": "mmsg dispatch quit",
			      "poweroff": "systemctl poweroff",
			      "reboot": "systemctl reboot"
		    }
    }
}
