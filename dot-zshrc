function l() {
	local tmp cwd; tmp="$(mktemp -t "lf-cwd.XXXXXX")"
	command lf "$@" -last-dir-path "$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd" || builtin true
	command rm -f -- "$tmp"
}

